---
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate } from '../lib/format';
import { formatLabel, hubAreaMeta, levelLabel, spokeMeta } from '../data/taxonomy';

interface Props {
  post: CollectionEntry<'writing'>;
}

const { post } = Astro.props;
const { data } = post;
---

<li class="card">
  <p class="meta">
    <time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate)}</time>
    · {formatLabel[data.format]} · {levelLabel[data.level]}
  </p>
  <h3><a href={`/writing/${post.id}/`}>{data.title}</a></h3>
  <p>{data.description}</p>
  <ul class="chips" aria-label="Topics">
    {data.draft && <li class="chip chip--draft">draft</li>}
    <li><span class="chip chip--hub">{hubAreaMeta[data.hub].label}</span></li>
    {
      data.spokes.map((s) => (
        <li>
          <a class="chip" href={`/spokes/${s}/`}>
            {spokeMeta[s].label}
          </a>
        </li>
      ))
    }
  </ul>
</li>
