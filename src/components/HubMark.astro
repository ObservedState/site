---
// The Hub icon as inline SVG so it follows the light/dark theme.
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 96 96" fill="none" aria-hidden="true" focusable="false">
  <g transform="translate(0,3.2)">
    <g class="spokes" stroke-width="3" stroke-linecap="round">
      <line x1="48" y1="48" x2="48" y2="14"></line>
      <line x1="48" y1="48" x2="80.3" y2="37.5"></line>
      <line x1="48" y1="48" x2="68" y2="75.5"></line>
      <line x1="48" y1="48" x2="28" y2="75.5"></line>
      <line x1="48" y1="48" x2="15.7" y2="37.5"></line>
    </g>
    <circle cx="48" cy="48" r="10" class="hub"></circle>
    <circle cx="48" cy="14" r="6.5" class="desired" stroke-width="3.2" stroke-dasharray="4.2 3.2"></circle>
    <circle cx="80.3" cy="37.5" r="6.5" class="node" stroke-width="3.2"></circle>
    <circle cx="68" cy="75.5" r="6.5" class="node" stroke-width="3.2"></circle>
    <circle cx="28" cy="75.5" r="6.5" class="node" stroke-width="3.2"></circle>
    <circle cx="15.7" cy="37.5" r="6.5" class="node" stroke-width="3.2"></circle>
  </g>
</svg>

<style>
  .spokes {
    stroke: var(--spoke-line);
  }
  .hub {
    fill: var(--observed);
  }
  .node {
    fill: var(--bg);
    stroke: var(--text);
  }
  .desired {
    fill: var(--bg);
    stroke: var(--desired);
  }
</style>
