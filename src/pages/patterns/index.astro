---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PatternCard from '../../components/PatternCard.astro';
import { getPublished } from '../../lib/content';

const patterns = (await getPublished('patterns')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Integration patterns"
  description="A catalog of how data and control move between ServiceNow and the systems around it: direction, mechanism, CI classes, identification keys and failure modes."
>
  <div class="container section">
    <p class="eyebrow">Patterns</p>
    <h1>Integration patterns</h1>
    <p class="lede">
      One page per pattern, all on the same template: direction, mechanism, CI classes touched, identification keys,
      failure modes, and what I would do.
    </p>
    {
      patterns.length > 0 ? (
        <ul class="card-grid" style="list-style: none; padding: 0; margin: 2rem 0 0">
          {patterns.map((pattern) => (
            <PatternCard pattern={pattern} />
          ))}
        </ul>
      ) : (
        <p class="empty" style="margin-top: 2rem">
          The catalog is empty for now.
        </p>
      )
    }
  </div>
</BaseLayout>
