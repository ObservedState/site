---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" noindex={true}>
  <div class="container section">
    <p class="eyebrow">404</p>
    <h1>Declared, but not observed.</h1>
    <p class="lede">That page isn't here. It may have moved, or it may never have existed.</p>
    <div class="btn-row">
      <a class="btn" href="/">Home</a>
      <a class="btn btn--ghost" href="/writing/">Writing</a>
    </div>
  </div>
</BaseLayout>
