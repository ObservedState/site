---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PathCard from '../../components/PathCard.astro';
import { getPublished } from '../../lib/content';

const paths = (await getPublished('paths')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Learning paths"
  description="Curated sequences of reading, building and certifying for people connecting ServiceNow to cloud, infrastructure as code and AI."
>
  <div class="container section">
    <p class="eyebrow">Paths</p>
    <h1>Learning paths</h1>
    <p class="lede">
      Ordered steps of reading, building, certifying and writing up, with notes on what is worth the time. The
      <a href="/drift-log/">Drift Log</a> is where I record how each one goes.
    </p>
    {
      paths.length > 0 ? (
        <ul class="card-grid" style="list-style: none; padding: 0; margin: 2rem 0 0">
          {paths.map((path) => (
            <PathCard path={path} />
          ))}
        </ul>
      ) : (
        <p class="empty" style="margin-top: 2rem">
          The first paths are being written.
        </p>
      )
    }
  </div>
</BaseLayout>
