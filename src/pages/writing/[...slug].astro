---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublished } from '../../lib/content';
import { formatDate, isoDate } from '../../lib/format';
import { formatLabel, hubAreaMeta, levelLabel, spokeMeta } from '../../data/taxonomy';

export async function getStaticPaths() {
  const posts = await getPublished('writing');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
---

<BaseLayout title={data.title} description={data.description} type="article" noindex={data.draft}>
  <article class="container">
    <header class="article-head">
      <p class="meta">
        <time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate)}</time>
        {
          data.updatedDate && (
            <>
              · updated <time datetime={isoDate(data.updatedDate)}>{formatDate(data.updatedDate)}</time>
            </>
          )
        }
        · {formatLabel[data.format]} · {levelLabel[data.level]}
      </p>
      <h1>{data.title}</h1>
      <p class="lede">{data.description}</p>
      <ul class="chips" aria-label="Topics">
        {data.draft && <li class="chip chip--draft">draft</li>}
        <li><a class="chip chip--hub" href="/hub/">{hubAreaMeta[data.hub].label}</a></li>
        {
          data.spokes.map((s) => (
            <li>
              <a class="chip" href={`/spokes/${s}/`}>
                {spokeMeta[s].label}
              </a>
            </li>
          ))
        }
      </ul>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
